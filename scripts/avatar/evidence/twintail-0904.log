=== [R5] build.py 外套守衛（twintail.coat_intrusion）對舊檔／新檔，與珠子半徑的 SystemExit（腳本 coatgate_receipt.py） ===
"""Receipt: build.py's coat gate (TAIL_COAT_INTRUSION_MAX / TAIL_COAT_INSIDE_SHARE_MAX)
measured on the OLD shipped file and on the new one, and twintail's bead-radius
SystemExit. Reads the coat torso vertices back from the file the same way
build.py selects them (Mellow_Outer primitives of Body.baked, vertices whose
dominant joint is not an Arm/Hand/Shoulder bone)."""
import json, sys
import numpy as np
sys.path.insert(0, '/Users/charles/portfolio/scripts/avatar')
import glb, twintail
import build

def coat_vertices(doc, views):
    mesh = next(m for m in doc['meshes'] if m['name'] == 'Body.baked')
    skin = doc['skins'][0]
    out = []
    for pr in mesh['primitives']:
        if doc['materials'][pr['material']]['name'] != 'Mellow_Outer':
            continue
        pos = glb.read_accessor(doc, views, pr['attributes']['POSITION']).astype(np.float64)
        j = glb.read_accessor(doc, views, pr['attributes']['JOINTS_0'])
        w = glb.read_accessor(doc, views, pr['attributes']['WEIGHTS_0'])
        lead = j[np.arange(len(j)), w.argmax(axis=1)]
        names = np.array([doc['nodes'][skin['joints'][int(k)]].get('name', '') for k in lead])
        torso = np.array([not any(t in n for t in ('Arm', 'Hand', 'Shoulder')) for n in names])
        out.append(pos[torso])
    return np.concatenate(out)

for label, path in (('OLD mika-milfy-2 (git HEAD)', sys.argv[1]), ('NEW mika-milfy-3', sys.argv[2])):
    doc, binary = glb.load(path)
    views = glb.views_of(doc, binary)
    manifest = json.load(open(path.replace('.vrm', '.parts.json')))['parts']
    coat = coat_vertices(doc, views)
    deepest, share = twintail.coat_intrusion(doc, views, manifest, coat)
    verdict = ('SystemExit (gate trips)' if deepest > build.TAIL_COAT_INTRUSION_MAX
               or share > build.TAIL_COAT_INSIDE_SHARE_MAX else 'passes')
    print(f'{label}: coat torso vertices {len(coat)}, deepest {deepest:.1f}mm '
          f'(limit {build.TAIL_COAT_INTRUSION_MAX:.0f}), share>=5mm {share*100:.1f}% '
          f'(limit {build.TAIL_COAT_INSIDE_SHARE_MAX*100:.0f}%) -> {verdict}')
    if label.startswith('NEW'):
        contour = twintail.CoatContour(coat)
        n = len(twintail.coat_spheres(contour, twintail.TAIL_HIT_RADIUS))
        print(f'bead-radius invariant: coat_spheres with hitRadius {twintail.TAIL_HIT_RADIUS} -> {n} beads')
        try:
            twintail.coat_spheres(contour, twintail.TAIL_HIT_RADIUS - 0.10)
            print('bead-radius invariant: hitRadius-0.10 did NOT raise  <-- guard broken')
        except SystemExit as e:
            print(f'bead-radius invariant: hitRadius-0.10 -> SystemExit: {e}')
--- output ---
