# The pitch class offline, on every registered family body. 2026-09-10.
#
# Generated by a throwaway test that imports the shipped gesture table
# through gestureOffsets() and poses rigProbe rigs with the result. It
# is the offline half of pitch-0910-browser.log, which measures the same
# three gestures through the real engine on the milfy body.
#
# PART 1 -- the bare axes. One rotation on one bone, so the sign of each
# axis belongs to the body and not to any gesture. "toward face" is the
# component along the way her eyes point, read off the eye against the
# head; "toward her left" is along her own left, read off her two hands.
#
vroid-sample-b        VRM 0  facingSign -1  faceZ -1  herLeft -1  body mika-pink.vrm
    head.x   0.30   eye toward face   -18.19mm   eye dY     6.22mm
    head.x   0.14   eye toward face    -8.25mm   eye dY     3.58mm
    head.x   0.05   eye toward face    -2.89mm   eye dY     1.41mm
    head.x  -0.05   eye toward face     2.81mm   eye dY    -1.55mm
    head.x  -0.14   eye toward face     7.67mm   eye dY    -4.70mm
    head.x  -0.30   eye toward face    15.54mm   eye dY   -11.31mm
    spine.x  0.05   head toward face   -19.49mm
    spine.x -0.05   head toward face    19.54mm
    head.y   0.10   eye toward her left     2.87mm
    head.y  -0.10   eye toward her left    -3.05mm
    head.z   0.16   eye toward her left     8.86mm
    head.z  -0.16   eye toward her left    -9.32mm

vrm1-twist-sample     VRM 1  facingSign  1  faceZ  1  herLeft  1  body vrm1-twist-sample.vrm
    head.x   0.30   eye toward face    17.55mm   eye dY    -9.13mm
    head.x   0.14   eye toward face     8.53mm   eye dY    -3.60mm
    head.x   0.05   eye toward face     3.10mm   eye dY    -1.15mm
    head.x  -0.05   eye toward face    -3.16mm   eye dY     0.99mm
    head.x  -0.14   eye toward face    -8.95mm   eye dY     2.38mm
    head.x  -0.30   eye toward face   -19.47mm   eye dY     3.54mm
    spine.x  0.05   head toward face    21.35mm
    spine.x -0.05   head toward face   -21.25mm
    head.y   0.10   eye toward her left     2.05mm
    head.y  -0.10   eye toward her left    -2.23mm
    head.z   0.16   eye toward her left   -10.20mm
